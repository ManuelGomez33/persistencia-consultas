# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=pdfs_db
MONGO_COLLECTION=pdfs

# Redis (caché)
REDIS_URL=redis://localhost:6379/0
REDIS_TTL_SECONDS=300

# Opcional: DEBUG, INFO, WARNING o ERROR (contrato 1.2.0)
LOG_LEVEL=INFO

# Registro opcional en Consul. En Docker se usa el secreto generado por
# dockers/consul/scripts/prepare-microservices-token.ps1.
CONSUL_ENABLED=false
CONSUL_HTTP_ADDR=http://consul:8500
CONSUL_HTTP_TOKEN_FILE=
CONSUL_SERVICE_PORT=8000
